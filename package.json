{
  "name": "prpreview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:reaper": "tsx watch src/reaper/index.ts",
    "start:server": "node dist/server/index.js",
    "start:worker": "node dist/worker/index.js",
    "start:reaper": "node dist/reaper/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:preflight": "node scripts/check-migration-baseline.js",
    "prisma:deploy": "node scripts/check-migration-baseline.js && prisma migrate deploy",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:production": "node scripts/verify-production.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "@fastify/static": "^7.0.4",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/node": "^20.14.2",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^8.57.1"
  }
}
