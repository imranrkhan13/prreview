# The Railway backend's public URL. Never a relative path — the dashboard
# is hosted on Vercel and the API is hosted separately on Railway, so a
# relative fetch("/api/...") would incorrectly hit the Vercel origin.
VITE_API_URL="https://prreview-production-7f5b.up.railway.app"

# Local development against a locally-running backend:
# VITE_API_URL="http://localhost:3000"

# Do NOT put backend secrets here (DATABASE_URL, RAILWAY_API_TOKEN,
# GITHUB_WEBHOOK_SECRET, etc.) — anything in a Vite env var is bundled
# into client-side JS and is publicly visible.
